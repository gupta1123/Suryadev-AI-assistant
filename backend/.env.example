NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Hosted Supabase project settings. Keep the service-role key backend-only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Required by the backend for private storage, queueing, checkpoints, and status updates.
SUPABASE_SERVICE_ROLE_KEY=

# Single-company administrator login. Change the password before deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
AUTH_SESSION_HOURS=720
# Persistent signing secret (at least 32 characters). Keep the same value across restarts.
AUTH_SESSION_SECRET=

# Keep fixture mode for isolated WhatsApp testing. Live SAP mode is GET-only.
INVOICE_SOURCE=fixture
FIXTURE_DIRECTORY=fixtures/sap
DELIVERY_MODE=test

# SAP Public Cloud read-only integration. SAP_API_BASE_URL is the OData root
# before the service name, for example https://tenant-api.s4hana.cloud.sap/sap/opu/odata/sap.
SAP_BASE_URL=https://tenant.s4hana.cloud.sap
SAP_API_BASE_URL=https://tenant-api.s4hana.cloud.sap/sap/opu/odata/sap
SAP_API_USERNAME=
SAP_API_PASSWORD=
SAP_POLL_ENABLED=false
SAP_POLL_INTERVAL_MS=15000
SAP_POLL_START_DATE=2026-07-29
SAP_ALLOWED_CUSTOMERS=550071
SAP_REQUEST_TIMEOUT_MS=30000

# Database-backed delivery worker.
JOB_POLL_INTERVAL_MS=5000
JOB_LOCK_TIMEOUT_MINUTES=15

# MSG91 secrets belong only in the backend environment.
MSG91_AUTHKEY=
MSG91_INTEGRATED_NUMBER=
MSG91_SEND_ENABLED=false
MSG91_TEMPLATE_NAME=share_invoice
MSG91_TEMPLATE_LANGUAGE=en
MSG91_TEMPLATE_TEAM_NAME=SuryaDev
MSG91_WEBHOOK_SECRET=
MSG91_STATUS_POLL_ENABLED=true
MSG91_STATUS_POLL_INTERVAL_MS=15000

# Controlled payment follow-up test. Production additionally requires the explicit
# deployment switch. The backend still hard-locks all reminders to one test number.
PAYMENT_FOLLOW_UP_ENABLED=false
PAYMENT_FOLLOW_UP_SEND_ENABLED=false
PAYMENT_TEST_DEPLOYMENT_ENABLED=false
PAYMENT_RECEIVABLE_SOURCE=test_fixture
PAYMENT_TEST_RECIPIENT=
PAYMENT_TEST_CUSTOMER=
PAYMENT_TEST_INVOICE=
PAYMENT_TEST_DUE_DATE=
PAYMENT_TEST_OUTSTANDING_AMOUNT=
MSG91_PAYMENT_TEMPLATE_NAME=payment_reminder_v1
MSG91_PAYMENT_TEMPLATE_LANGUAGE=en
PAYMENT_FIRST_REMINDER_DELAY_SECONDS=120
PAYMENT_REPEAT_REMINDER_DELAY_SECONDS=20
PAYMENT_TEST_MAX_REMINDERS=2
PAYMENT_SCHEDULER_POLL_INTERVAL_MS=5000

# Comma-separated E.164 numbers. In test mode no other recipient can be used.
WHATSAPP_DEFAULT_TEST_RECIPIENT=
WHATSAPP_TEST_RECIPIENTS=
